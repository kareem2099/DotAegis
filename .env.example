# LLM Secret Detection Service - Environment Variables Template
# Copy this file to .env and fill in the values

# Environment: development or production
ENVIRONMENT=development

# List of allowed API keys for internal use (comma-separated)
# Format: key1,key2,key3
API_KEY=

# Secret key for JWT token generation
# Use a strong, random 256-bit string in production
JWT_SECRET=

# Shared secret for VS Code extension HMAC authentication
# Must match the 'dotenvy.llm.sharedSecret' set in the extension
EXTENSION_SHARED_SECRET=

# Database Connection URL
# SQLite fallback: sqlite:///./llm_service.db
# Supabase Example: postgresql://postgres:[PASSWORD]@db.[PROJ_ID].supabase.co:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./llm_service.db

# Rate limiting: max requests per minute per IP/Machine
RATE_LIMIT_REQUESTS_PER_MINUTE=60
EXTENSION_RATE_LIMIT=30

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Logging format: console or json
LOG_FORMAT=console

# Server Port (Railway sets this automatically)
PORT=8000
