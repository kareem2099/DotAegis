# ==============================================================================
# 🛡️ DotAegis - Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' and configure your environment-specific values.
# In production (e.g., Railway/Docker), set these variables in your deployment dashboard.

# --- Environment Mode ---
# Options: development, production, test
ENVIRONMENT=development

# --- Security & Authentication ---
# Comma-separated list of allowed API keys for internal & admin endpoints
# Example: key1,key2,key3
API_KEY=

# 256-bit cryptographically secure secret for internal token signing
JWT_SECRET=

# Optional legacy fallback secret for older DotEnvy clients (prior to v2.1.2)
# Modern installations (v2.1.2+) use dynamic per-device registration via POST /extension/register
EXTENSION_SHARED_SECRET=

# --- Database & Persistence ---
# SQLite fallback (local development): sqlite:///./llm_service.db
# PostgreSQL (production): postgresql://user:password@host:5432/dotaegis
DATABASE_URL=sqlite:///./llm_service.db

# --- Distributed Cache (Redis) ---
# Optional: Redis connection URL for L2 caching (e.g. redis://default:password@host:6379)
# If left empty, DotAegis will gracefully fall back to in-memory L1 LRU caching
REDIS_URL=

# --- Rate Limiting ---
# General API requests per minute per IP
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Max requests per minute per registered VS Code machine ID
EXTENSION_RATE_LIMIT=30

# Max dynamic device registrations per hour per IP (anti-spam / anti-harvesting)
REGISTRATION_RATE_LIMIT_PER_IP=10

# --- Networking & CORS ---
# Comma-separated origins allowed to make cross-origin requests
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Logging ---
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format: 'console' for human-readable, 'json' for production aggregation
LOG_FORMAT=console

# --- Server Port ---
# Railway / Render / Heroku sets this automatically
PORT=8000
